From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 23 Nov 2026 11:01:11 +0000
Subject: [PATCH] Restyle a non-subject :has() anchor's subtree on an insert
 between siblings

Inserting between two siblings under a `:has(> .a + .b)` anchor re-matched the
anchor itself. When the anchor is not the subject (`.p:has(> .a + .b) .y`), the
element that must change sits under it, so `.y` kept the style from the previous
match. Restyle the anchor's subtree when it carries
ANCHORS_RELATIVE_SELECTOR_NON_SUBJECT, keep RESTYLE_SELF for a subject-only
anchor, and walk ancestors so the descendant form (`.p:has(.a + .b) .y`) is
covered too. The walk is gated on the document having any relative selector.
---
 src/stylo.rs | 32 ++++++++++++++++++++++++--------
 1 file changed, 24 insertions(+), 8 deletions(-)

diff --git a/src/stylo.rs b/src/stylo.rs
index 8c1f1e1..979c608 100644
--- a/src/stylo.rs
+++ b/src/stylo.rs
@@ -531,14 +531,30 @@ impl crate::document::BaseDocument {
                 self.invalidate_relative_selectors_for_sibling_side_effects(prev, next);
             } else if let Some(parent) = selectors::Element::parent_element(&element) {
                 // Inserting between two siblings under a `:has(> .a + .b)` anchor can break a
-                // child-level sibling combinator without changing the inserted node's own match;
-                // restyle only the anchor itself (never its whole subtree).
-                if parent.selector_flags().get().intersects(
-                    ElementSelectorFlags::ANCHORS_RELATIVE_SELECTOR
-                        | ElementSelectorFlags::ANCHORS_RELATIVE_SELECTOR_NON_SUBJECT,
-                ) {
-                    if let Some(mut data) = parent.mutate_data() {
-                        data.hint |= RestyleHint::RESTYLE_SELF;
+                // child-level sibling combinator without changing the inserted node's own match.
+                // An anchor that is only the subject re-matches itself, but when the subject is a
+                // descendant (`.p:has(> .a + .b) .y`) the element that must change sits under the
+                // anchor, so the anchor's subtree is restyled as it was before the invalidation
+                // rewrite. The anchor can also be an ancestor of the inserted node's parent, which
+                // is the descendant form (`.p:has(.a + .b) .y`).
+                if self.has_relative_selectors() {
+                    let mut anchor = Some(parent);
+                    while let Some(node) = anchor {
+                        let flags = node.selector_flags().get();
+                        if flags
+                            .intersects(ElementSelectorFlags::ANCHORS_RELATIVE_SELECTOR_NON_SUBJECT)
+                        {
+                            if let Some(mut data) = node.mutate_data() {
+                                data.hint |=
+                                    RestyleHint::RESTYLE_SELF | RestyleHint::RESTYLE_DESCENDANTS;
+                            }
+                        } else if flags.intersects(ElementSelectorFlags::ANCHORS_RELATIVE_SELECTOR)
+                        {
+                            if let Some(mut data) = node.mutate_data() {
+                                data.hint |= RestyleHint::RESTYLE_SELF;
+                            }
+                        }
+                        anchor = selectors::Element::parent_element(&node);
                     }
                 }
             }
